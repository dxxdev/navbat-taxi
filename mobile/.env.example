# Nusxa oling: cp .env.example .env.local
# Faqat PUBLIC qiymatlar! EXPO_PUBLIC_ bundle ichiga tushadi, secret kalit qo'ymang.

# Bo'sh qoldirilsa: web -> http://127.0.0.1:54321, Android emulyator -> http://10.0.2.2:54321
# Haqiqiy qurilma (Expo Go) uchun kompyuteringizning LAN IP'sini yozing: http://192.168.x.x:54321
EXPO_PUBLIC_SUPABASE_URL=

# `supabase status` dagi Publishable key (yoki eski CLI'da anon key)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=