{
  "expo": {
    "name": "NavbatTaksi",
    "slug": "navbat-taksi",
    "scheme": "navbattaksi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "uz.navbattaksi.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hujjat va mashina rasmlarini yuklash uchun galereyaga ruxsat kerak."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
